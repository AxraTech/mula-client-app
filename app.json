{
  "expo": {
    "name": "MULA",
    "slug": "mula-gallery",
    "version": "2",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "scheme": "mula-gallery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.axratech.mula",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "MULA",
        "CFBundleShortVersionString": "5"
      }
    },
    "android": {
      "package": "com.axra.mula",
      "versionCode": 2,
      "backgroundColor": "#F5F0E8",
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/appicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cde9bdac-7ef1-4d9f-9ef6-5f8c40eaaeea"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cde9bdac-7ef1-4d9f-9ef6-5f8c40eaaeea"
    }
  }
}
