{
  "expo": {
    "name": "Mula Art Gallery",
    "slug": "mula-gallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos.png",
    "scheme": "mula-gallery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.mula.artgallery",
      "backgroundColor": "#F5F0E8"
    },
    "web": {
      "favicon": "./assets/images/logos.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cde9bdac-7ef1-4d9f-9ef6-5f8c40eaaeea"
      }
    }
  }
}
